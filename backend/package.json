{
  "name": "verisumm-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "seed": "ts-node-dev --transpile-only scripts/seedDemoData.ts",
    "benchmark": "ts-node-dev --transpile-only scripts/runBenchmark.ts",
    "build:test": "tsc -p tsconfig.jest.json",
    "test": "npm run build:test && npm run test:unit && npm run test:integration",
    "test:unit": "node --max-old-space-size=256 dist-test/tests/chunking.runner.js",
    "test:integration": "MONGOMS_SYSTEM_BINARY=/home/rohith/.cache/mongodb-binaries/mongod-x64-fedora-7.0.24 MONGOMS_VERSION=7.0.24 node --max-old-space-size=4096 ../node_modules/.bin/jest --runInBand --forceExit --testPathPattern='models|auth|ingestion|jobs|verification|audit|benchmark|collections|deploymentMode|chunking|multilingual'",
    "test:coverage": "MONGOMS_SYSTEM_BINARY=/home/rohith/.cache/mongodb-binaries/mongod-x64-fedora-7.0.24 MONGOMS_VERSION=7.0.24 node --max-old-space-size=4096 ../node_modules/.bin/jest --runInBand --forceExit --coverage --testPathPattern='models|auth|ingestion|jobs|verification|audit|benchmark|collections|deploymentMode|chunking|multilingual'"
  },
  "dependencies": {
    "@verisumm/common": "*",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.0",
    "mongoose": "^8.2.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.8",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/dist-test/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "dist-test/src/**/*.js",
      "!dist-test/src/index.js",
      "!dist-test/src/scripts/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "statements": 70
      },
      "./dist-test/src/chunking/": {
        "lines": 80,
        "statements": 80
      },
      "./dist-test/src/verification/": {
        "lines": 80,
        "statements": 80
      },
      "./dist-test/src/auth/": {
        "lines": 75,
        "statements": 75
      },
      "./dist-test/src/audit/": {
        "lines": 75,
        "statements": 75
      }
    }
  },
  "mongodbMemoryServer": {
    "version": "7.0.7",
    "arch": "x86_64",
    "platform": "linux",
    "distro": "rhel90"
  }
}
