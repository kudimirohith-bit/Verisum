# ==============================================================================
# VeriSum Platform — Production Environment Configuration (.env.prod.example)
# Copy to infra/.env.prod and populate prior to production deployment.
# ==============================================================================

# ── Deployment & Privacy Mode ──────────────────────────────────────────────────
# Choices: 'offline' (fully on-premises/self-hosted; blocks external LLM API calls)
#          'hybrid'  (allows both local models and external hosted LLM backends)
DEPLOYMENT_MODE=offline

# ── Server & Security ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://localhost
CORS_ORIGIN=https://localhost

# JWT Secret for Auth Tokens (or use JWT_SECRET_FILE for mounted Docker secrets)
JWT_SECRET=replace_this_with_a_secure_64_character_random_string

# Mounted Secret Support (Alternative to plain env vars in production)
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# LLM_API_KEY_FILE=/run/secrets/llm_api_key

# ── Database & Cache ──────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/verisumm
REDIS_URL=redis://redis:6379

# ── Model Service Integration ─────────────────────────────────────────────────
MODEL_SERVICE_URL=http://model-service:8000

# ── External Hosted LLM Configuration (Hybrid Mode Only) ──────────────────────
# Provider choices: 'anthropic', 'openai'
LLM_PROVIDER=anthropic
LLM_API_KEY=your_external_api_key_here
LLM_MODEL_NAME=claude-3-haiku-20240307
