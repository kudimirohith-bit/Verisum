# Server & App Environment
PORT=5000
NODE_ENV=development
DEPLOYMENT_MODE=local # 'local' (FastAPI microservice) or 'hosted' (LLM API)

# MongoDB Database Connection
MONGO_URI=mongodb://localhost:27017/verisumm

# Redis Connection (BullMQ Queue)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-verisumm-clinical-2026
JWT_EXPIRES_IN=7d

# Model Inference Services
MODEL_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000
